{
  "name": "markino",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.7.1",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "start": "HOST=0.0.0.0 PORT=3000 node ./dist/server/entry.mjs",
    "lint": "eslint",
    "typecheck": "astro sync && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:local": "docker compose up -d --wait postgres",
    "db:migrate": "drizzle-kit migrate",
    "db:setup": "pnpm run db:local && pnpm run db:migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.5",
    "@astrojs/react": "^6.0.5",
    "@astrojs/svelte": "^9.0.1",
    "@base-ui/react": "^1.5.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@tanstack/react-table": "^8.21.3",
    "astro": "^7.3.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "layerchart": "^2.4.0",
    "postgres": "^3.4.9",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-day-picker": "^10.0.0",
    "react-dom": "19.2.4",
    "sonner": "^2.0.7",
    "svelte": "^5.57.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "shadcn": "^4.7.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
