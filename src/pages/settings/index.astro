---
import BaseLayout from "@/layouts/base-layout.astro";
import ProfileSelectionPanel from "@/components/profiles/profile-selection-panel.astro";
import SettingsWatchedWithForm from "@/components/settings/settings-watched-with-form.svelte";
import SettingsDataBackup from "@/components/settings/settings-data-backup.svelte";
import { listLocalProfiles } from "@/lib/local-profiles";
import { getSettingsPageData } from "@/server/settings-page-data";

const user = Astro.locals.user;
const profiles = user?.id ? [] : await listLocalProfiles();
const settingsData = user?.id ? await getSettingsPageData(user.id) : null;
---

<BaseLayout title="Settings">
  {user?.id && settingsData ? (
    <section class="space-y-6">
      <header class="space-y-2">
        <h1 class="text-2xl font-medium tracking-[-0.03em]">Settings</h1>
        <p class="max-w-2xl text-sm text-[var(--muted-foreground)]">
          Configure entry defaults and manage installation data.
        </p>
      </header>
      <SettingsWatchedWithForm
        client:load
        defaultWatchedWith={settingsData.defaultWatchedWith}
        userId={user.id}
        watchedWithOptions={settingsData.watchedWithOptions}
      />
      {user.role === "superadmin" && <SettingsDataBackup client:load />}
    </section>
  ) : (
    <ProfileSelectionPanel profiles={profiles} />
  )}
</BaseLayout>
