---
import BaseLayout from "@/layouts/base-layout.astro";
import { SyncMovieMetadataButton } from "@/components/movies/sync-movie-metadata-button";
import ProfileSelectionPanel from "@/components/profiles/profile-selection-panel.astro";
import { getMovieByIdForUser } from "@/lib/movies";
import { listLocalProfiles } from "@/lib/local-profiles";

const user = Astro.locals.user;
const profiles = user?.id ? [] : await listLocalProfiles();
const movie = user?.id
  ? await getMovieByIdForUser(Astro.params.id ?? "", user.id)
  : null;

if (user?.id && !movie) {
  return new Response(null, { status: 404 });
}

const canSyncMetadata = user?.role === "superadmin";
const hasCredits =
  Boolean(movie?.director) ||
  Boolean(movie?.writer) ||
  Boolean(movie?.editor) ||
  (movie?.cast.length ?? 0) > 0;
const posterUrl = movie?.posterPath
  ? `https://image.tmdb.org/t/p/w500${movie.posterPath}`
  : null;

function joinValues(values: string[]) {
  return values.length > 0 ? values.join(", ") : "-";
}

function formatSyncedAt(value: Date | null) {
  if (!value) {
    return "-";
  }

  return new Intl.DateTimeFormat("en", {
    dateStyle: "medium",
    timeStyle: "short",
  }).format(value);
}

function formatRuntime(minutes: number | null) {
  if (!minutes) {
    return "-";
  }

  const hours = Math.floor(minutes / 60);
  const remainingMinutes = minutes % 60;

  return hours > 0 ? `${hours}h ${remainingMinutes}m` : `${remainingMinutes}m`;
}

function formatMoney(value: number | null) {
  if (!value) {
    return "-";
  }

  return new Intl.NumberFormat("en", {
    style: "currency",
    currency: "USD",
    maximumFractionDigits: 0,
  }).format(value);
}
---

<BaseLayout title={movie?.title ?? "Movies"}>
  {user?.id && movie ? (
    <section class="space-y-6">
    <div class="space-y-2">
      <a
        href="/movies"
        class="text-xs uppercase tracking-[0.18em] text-[var(--muted-foreground)] hover:text-[var(--foreground)]"
      >
        Movies
      </a>
      <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
        <div class="space-y-1">
          <h1 class="text-3xl font-medium tracking-[-0.04em]">
            {movie.title}
          </h1>
          {movie.tagline ? (
            <p class="text-sm text-[var(--muted-foreground)]">
              {movie.tagline}
            </p>
          ) : null}
        </div>
        {canSyncMetadata ? (
          <SyncMovieMetadataButton
            client:load
            movieId={movie.movieId}
            title={movie.title}
            userId={user.id}
          />
        ) : null}
      </div>
    </div>
    <dl class="grid border border-[var(--border)] text-sm sm:grid-cols-2">
      <div class="grid grid-cols-[9rem_1fr] border-b border-[var(--border)] px-4 py-3 sm:border-r">
        <dt class="text-[var(--muted-foreground)]">Preference</dt>
        <dd>{movie.rank}</dd>
      </div>
      <div class="grid grid-cols-[9rem_1fr] border-b border-[var(--border)] px-4 py-3">
        <dt class="text-[var(--muted-foreground)]">Watched on</dt>
        <dd>{movie.watchedDateDisplay}</dd>
      </div>
      <div class="grid grid-cols-[9rem_1fr] border-b border-[var(--border)] px-4 py-3 sm:border-b-0 sm:border-r">
        <dt class="text-[var(--muted-foreground)]">Language</dt>
        <dd>{movie.language}</dd>
      </div>
      <div class="grid grid-cols-[9rem_1fr] px-4 py-3">
        <dt class="text-[var(--muted-foreground)]">Status</dt>
        <dd>{movie.status}</dd>
      </div>
    </dl>
    {movie.isMetadataSynced ? (
      <>
        <section class="border border-[var(--border)]">
          <div class="border-b border-[var(--border)] px-4 py-3 text-[11px] font-medium uppercase tracking-[0.24em] text-[var(--muted-foreground)]">
            TMDB Metadata
          </div>
          <dl class="grid text-sm sm:grid-cols-2">
            <div class="grid grid-cols-[9rem_1fr] border-b border-[var(--border)] px-4 py-3 sm:border-r">
              <dt class="text-[var(--muted-foreground)]">TMDB ID</dt>
              <dd>
                {movie.tmdbId ? (
                  <a
                    href={`https://www.themoviedb.org/movie/${movie.tmdbId}`}
                    target="_blank"
                    rel="noreferrer"
                    class="hover:underline"
                  >
                    {movie.tmdbId}
                  </a>
                ) : "-"}
              </dd>
            </div>
            <div class="grid grid-cols-[9rem_1fr] border-b border-[var(--border)] px-4 py-3">
              <dt class="text-[var(--muted-foreground)]">Release</dt>
              <dd>{movie.releaseDate ?? movie.releaseYear ?? "-"}</dd>
            </div>
            <div class="grid grid-cols-[9rem_1fr] border-b border-[var(--border)] px-4 py-3 sm:border-r">
              <dt class="text-[var(--muted-foreground)]">Runtime</dt>
              <dd>{formatRuntime(movie.runtimeMinutes)}</dd>
            </div>
            <div class="grid grid-cols-[9rem_1fr] border-b border-[var(--border)] px-4 py-3">
              <dt class="text-[var(--muted-foreground)]">Original Title</dt>
              <dd>{movie.originalTitle ?? "-"}</dd>
            </div>
            <div class="grid grid-cols-[9rem_1fr] border-b border-[var(--border)] px-4 py-3 sm:border-r">
              <dt class="text-[var(--muted-foreground)]">Original Lang</dt>
              <dd>{movie.originalLanguage ?? "-"}</dd>
            </div>
            <div class="grid grid-cols-[9rem_1fr] border-b border-[var(--border)] px-4 py-3">
              <dt class="text-[var(--muted-foreground)]">IMDb ID</dt>
              <dd>
                {movie.imdbId ? (
                  <a
                    href={`https://www.imdb.com/title/${movie.imdbId}/`}
                    target="_blank"
                    rel="noreferrer"
                    class="hover:underline"
                  >
                    {movie.imdbId}
                  </a>
                ) : "-"}
              </dd>
            </div>
            <div class="grid grid-cols-[9rem_1fr] border-b border-[var(--border)] px-4 py-3 sm:border-r">
              <dt class="text-[var(--muted-foreground)]">Poster</dt>
              <dd>
                {posterUrl ? (
                  <a
                    href={posterUrl}
                    target="_blank"
                    rel="noreferrer"
                    class="hover:underline"
                  >
                    View image
                  </a>
                ) : "-"}
              </dd>
            </div>
            <div class="grid grid-cols-[9rem_1fr] border-b border-[var(--border)] px-4 py-3">
              <dt class="text-[var(--muted-foreground)]">Synced</dt>
              <dd>{formatSyncedAt(movie.metadataSyncedAt)}</dd>
            </div>
          </dl>
        </section>
        {movie.overview ? (
          <section class="border border-[var(--border)]">
            <div class="border-b border-[var(--border)] px-4 py-3 text-[11px] font-medium uppercase tracking-[0.24em] text-[var(--muted-foreground)]">
              Overview
            </div>
            <p class="px-4 py-3 text-sm leading-6">{movie.overview}</p>
          </section>
        ) : null}
        <section class="border border-[var(--border)]">
          <div class="border-b border-[var(--border)] px-4 py-3 text-[11px] font-medium uppercase tracking-[0.24em] text-[var(--muted-foreground)]">
            Production
          </div>
          <dl class="grid text-sm">
            <div class="grid grid-cols-[9rem_1fr] border-b border-[var(--border)] px-4 py-3">
              <dt class="text-[var(--muted-foreground)]">Genres</dt>
              <dd>{joinValues(movie.genres)}</dd>
            </div>
            <div class="grid grid-cols-[9rem_1fr] border-b border-[var(--border)] px-4 py-3">
              <dt class="text-[var(--muted-foreground)]">Origin</dt>
              <dd>{joinValues(movie.originCountries)}</dd>
            </div>
            <div class="grid grid-cols-[9rem_1fr] border-b border-[var(--border)] px-4 py-3">
              <dt class="text-[var(--muted-foreground)]">Countries</dt>
              <dd>{joinValues(movie.productionCountries)}</dd>
            </div>
            <div class="grid grid-cols-[9rem_1fr] border-b border-[var(--border)] px-4 py-3">
              <dt class="text-[var(--muted-foreground)]">Languages</dt>
              <dd>{joinValues(movie.spokenLanguages)}</dd>
            </div>
            <div class="grid grid-cols-[9rem_1fr] px-4 py-3">
              <dt class="text-[var(--muted-foreground)]">Studios</dt>
              <dd>{joinValues(movie.studios)}</dd>
            </div>
          </dl>
        </section>
        <section class="border border-[var(--border)]">
          <div class="border-b border-[var(--border)] px-4 py-3 text-[11px] font-medium uppercase tracking-[0.24em] text-[var(--muted-foreground)]">
            Financials
          </div>
          <dl class="grid text-sm sm:grid-cols-2">
            <div class="grid grid-cols-[9rem_1fr] border-b border-[var(--border)] px-4 py-3 sm:border-r sm:border-b-0">
              <dt class="text-[var(--muted-foreground)]">Budget</dt>
              <dd>{formatMoney(movie.budget)}</dd>
            </div>
            <div class="grid grid-cols-[9rem_1fr] px-4 py-3">
              <dt class="text-[var(--muted-foreground)]">Revenue</dt>
              <dd>{formatMoney(movie.revenue)}</dd>
            </div>
          </dl>
        </section>
        {hasCredits ? (
          <section class="border border-[var(--border)]">
            <div class="border-b border-[var(--border)] px-4 py-3 text-[11px] font-medium uppercase tracking-[0.24em] text-[var(--muted-foreground)]">
              Credits
            </div>
            <dl class="grid text-sm">
              {movie.director ? (
                <div class="grid grid-cols-[9rem_1fr] border-b border-[var(--border)] px-4 py-3">
                  <dt class="text-[var(--muted-foreground)]">Director</dt>
                  <dd>{movie.director}</dd>
                </div>
              ) : null}
              {movie.writer ? (
                <div class="grid grid-cols-[9rem_1fr] border-b border-[var(--border)] px-4 py-3">
                  <dt class="text-[var(--muted-foreground)]">Writer</dt>
                  <dd>{movie.writer}</dd>
                </div>
              ) : null}
              {movie.editor ? (
                <div class="grid grid-cols-[9rem_1fr] border-b border-[var(--border)] px-4 py-3">
                  <dt class="text-[var(--muted-foreground)]">Editor</dt>
                  <dd>{movie.editor}</dd>
                </div>
              ) : null}
              {movie.cast.length > 0 ? (
                <div class="grid grid-cols-[9rem_1fr] px-4 py-3">
                  <dt class="text-[var(--muted-foreground)]">Cast</dt>
                  <dd class="grid gap-1">
                    {movie.cast.map((credit) => (
                      <span>
                        {credit.name}
                        {credit.character ? (
                          <span class="text-[var(--muted-foreground)]">
                            {" "}as {credit.character}
                          </span>
                        ) : null}
                      </span>
                    ))}
                  </dd>
                </div>
              ) : null}
            </dl>
          </section>
        ) : null}
      </>
    ) : (
      <section class="border border-[var(--border)] px-4 py-3 text-sm text-[var(--muted-foreground)]">
        TMDB metadata has not been synced.
      </section>
    )}
    <section class="border border-[var(--border)]">
      <div class="border-b border-[var(--border)] px-4 py-3 text-[11px] font-medium uppercase tracking-[0.24em] text-[var(--muted-foreground)]">
        Watched With
      </div>
      <div class="px-4 py-3 text-sm">{movie.watchedWith.join(", ")}</div>
    </section>
    </section>
  ) : (
    <ProfileSelectionPanel profiles={profiles} />
  )}
</BaseLayout>
