---
import BaseLayout from "@/layouts/base-layout.astro";
import { MoviesScreenIsland } from "@/components/movies/movies-screen-island";
import { areSignupsEnabled } from "@/lib/auth-config";
import { getMovieScreenData } from "@/server/movie-page-data";

const user = Astro.locals.user;
const signupsEnabled = areSignupsEnabled();
const movieScreenData = user?.id ? await getMovieScreenData(user.id) : null;
---

<BaseLayout>
  {user?.id && movieScreenData ? (
    <MoviesScreenIsland
      client:load
      canSyncMetadata={user.role === "superadmin"}
      data={movieScreenData.movieLedger}
      defaultWatchedWith={movieScreenData.defaultWatchedWith}
      watchedWithOptions={movieScreenData.watchedWithOptions}
    />
  ) : (
    <section class="grid gap-8 py-12 lg:grid-cols-[minmax(0,2fr)_minmax(18rem,1fr)]">
      <div class="space-y-6">
        <div class="space-y-3">
          <div class="max-w-2xl text-sm leading-6 text-[var(--muted-foreground)] sm:text-base flex flex-col gap-2">
            <p>
              Markino is a watch log for personal and collaborative movie
              tracking.
            </p>
            <p>
              {signupsEnabled
                ? "Create your account to start tracking films."
                : "Account creation is currently disabled."}
            </p>
          </div>
        </div>
        <div class="flex flex-wrap gap-3 text-sm">
          <a
            href="/sign-in"
            class="inline-flex h-9 items-center border border-[var(--border)] px-3 font-medium hover:bg-[var(--accent)]"
          >
            Sign In
          </a>
          {signupsEnabled ? (
            <a
              href="/sign-up"
              class="inline-flex h-9 items-center border border-transparent px-3 text-[var(--muted-foreground)] hover:border-[var(--border)] hover:text-[var(--foreground)]"
            >
              Create Account
            </a>
          ) : null}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
