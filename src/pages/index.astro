---
import BaseLayout from "@/layouts/base-layout.astro";
import MoviesScreenIsland from "@/components/movies/movies-screen-island.svelte";
import ProfileSelectionPanel from "@/components/profiles/profile-selection-panel.astro";
import { MOVIE_NOUNS } from "@/consts/movie-nouns";
import { listLocalProfiles } from "@/lib/local-profiles";
import { getMovieScreenOptions } from "@/server/movie-page-data";

const user = Astro.locals.user;
const profiles = user?.id ? [] : await listLocalProfiles();
const movieScreenOptions = user?.id ? await getMovieScreenOptions(user.id) : null;
const movieNoun = MOVIE_NOUNS[Math.floor(Math.random() * MOVIE_NOUNS.length)];
---

<BaseLayout viewportConstrained>
  {user?.id && movieScreenOptions ? (
    <MoviesScreenIsland
      client:load
      defaultWatchedWith={movieScreenOptions.defaultWatchedWith}
      movieNoun={movieNoun}
      userId={user.id}
      watchedWithOptions={movieScreenOptions.watchedWithOptions}
    />
  ) : (
    <div class="py-10">
      <ProfileSelectionPanel profiles={profiles} />
    </div>
  )}
</BaseLayout>
