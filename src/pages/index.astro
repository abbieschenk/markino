---
import BaseLayout from "@/layouts/base-layout.astro";
import MoviesScreenIsland from "@/components/movies/movies-screen-island.svelte";
import ProfileSelectionPanel from "@/components/profiles/profile-selection-panel.astro";
import { listLocalProfiles } from "@/lib/local-profiles";
import { getMovieScreenData } from "@/server/movie-page-data";

const user = Astro.locals.user;
const profiles = user?.id ? [] : await listLocalProfiles();
const movieScreenData = user?.id ? await getMovieScreenData(user.id) : null;
---

<BaseLayout>
  {user?.id && movieScreenData ? (
    <MoviesScreenIsland
      client:load
      canSyncMetadata={user.role === "superadmin"}
      data={movieScreenData.movieLedger}
      defaultWatchedWith={movieScreenData.defaultWatchedWith}
      userId={user.id}
      watchedWithOptions={movieScreenData.watchedWithOptions}
    />
  ) : (
    <div class="py-10">
      <ProfileSelectionPanel profiles={profiles} />
    </div>
  )}
</BaseLayout>
