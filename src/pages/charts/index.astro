---
import BaseLayout from "@/layouts/base-layout.astro";
import { GenreOverTimePanel } from "@/components/charts/genre-over-time-panel";
import { LabelCountPanel } from "@/components/charts/label-count-panel";
import { MovieMoneyOverTimeChart } from "@/components/charts/movie-money-over-time-chart";
import { ProfileSelectionPanel } from "@/components/profiles/profile-selection-panel";
import { ReleaseYearsPanel } from "@/components/charts/release-years-panel";
import { WatchedByMonthPanel } from "@/components/charts/watched-by-month-panel";
import { WatchedOverTimeChart } from "@/components/charts/watched-over-time-chart";
import { getMovieChartStatsForUser } from "@/lib/movie-chart-stats";
import { listLocalProfiles } from "@/lib/local-profiles";

const user = Astro.locals.user;
const profiles = user?.id ? [] : await listLocalProfiles();
const stats = user?.id ? await getMovieChartStatsForUser(user.id) : null;
---

<BaseLayout title="Charts">
  {user?.id && stats ? (
    <div class="space-y-4">
      <div class="flex flex-wrap items-end justify-between gap-3 border-b border-[var(--border)] pb-3">
        <div>
          <h1 class="text-base font-medium">Charts</h1>
        </div>
      </div>

      <div class="grid gap-4 lg:grid-cols-2">
        <WatchedOverTimeChart
          client:idle
          monthlyData={stats.monthlyWatched}
          yearlyData={stats.yearlyWatched}
          monthlyOmittedCount={stats.yearOnlyWatchedOmittedFromMonthly}
        />

        <WatchedByMonthPanel
          client:idle
          data={stats.watchedByMonth}
        />

        <MovieMoneyOverTimeChart
          client:visible
          monthlyData={stats.monthlyMoneyOverTime}
          yearlyData={stats.yearlyMoneyOverTime}
          monthlyOmittedCount={stats.yearOnlyWatchedOmittedFromMonthly}
        />

        <ReleaseYearsPanel
          client:visible
          data={stats.releaseYears}
        />

        <GenreOverTimePanel
          client:visible
          yearlyData={stats.yearlyGenreOverTime}
        />

        <LabelCountPanel
          client:visible
          title="Top Directors"
          eyebrow="Top 20"
          data={stats.topDirectors}
          emptyLabel="No director metadata synced yet."
        />

        <LabelCountPanel
          client:visible
          title="Top Actors"
          eyebrow="Top-billed cast, top 20"
          data={stats.topActors}
          emptyLabel="No cast metadata synced yet."
        />
      </div>
    </div>
  ) : (
    <ProfileSelectionPanel client:load profiles={profiles} />
  )}
</BaseLayout>
