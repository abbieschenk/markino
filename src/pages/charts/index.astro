---
import BaseLayout from "@/layouts/base-layout.astro";
import ChartPanel from "@/components/charts/chart-panel.astro";
import GenreOverTimePanel from "@/components/charts/genre-over-time-panel.astro";
import LabelCountBarChart from "@/components/charts/label-count-bar-chart.svelte";
import MovieMoneyOverTimeChart from "@/components/charts/movie-money-over-time-chart.svelte";
import ProfileSelectionPanel from "@/components/profiles/profile-selection-panel.astro";
import ReleaseYearChart from "@/components/charts/release-year-chart.svelte";
import WatchedByMonthPanel from "@/components/charts/watched-by-month-panel.astro";
import WatchedOverTimeChart from "@/components/charts/watched-over-time-chart.svelte";
import { getMovieChartStatsForUser } from "@/lib/movie-chart-stats";
import { listLocalProfiles } from "@/lib/local-profiles";

const user = Astro.locals.user;
const profiles = user?.id ? [] : await listLocalProfiles();
const stats = user?.id ? await getMovieChartStatsForUser(user.id) : null;
---

<BaseLayout title="Charts">
  {user?.id && stats ? (
    <div class="space-y-4">
      <div class="flex flex-wrap items-end justify-between gap-3 border-b border-[var(--border)] pb-3">
        <div>
          <h1 class="text-base font-medium">Charts</h1>
        </div>
      </div>

      <div class="grid gap-4 lg:grid-cols-2">
        <WatchedOverTimeChart
          client:idle
          monthlyData={stats.monthlyWatched}
          yearlyData={stats.yearlyWatched}
          monthlyOmittedCount={stats.yearOnlyWatchedOmittedFromMonthly}
        />

        <WatchedByMonthPanel data={stats.watchedByMonth} />

        <MovieMoneyOverTimeChart
          client:idle
          monthlyData={stats.monthlyMoneyOverTime}
          yearlyData={stats.yearlyMoneyOverTime}
          monthlyOmittedCount={stats.yearOnlyWatchedOmittedFromMonthly}
        />

        <ChartPanel title="Release Years" contentClass="mt-auto">
          <ReleaseYearChart client:idle data={stats.releaseYears} />
        </ChartPanel>

        <GenreOverTimePanel yearlyData={stats.yearlyGenreOverTime} />

        <ChartPanel title="Top Directors" eyebrow="Top 20">
          <LabelCountBarChart
            client:idle
            data={stats.topDirectors}
            emptyLabel="No director metadata synced yet."
            scrollable
          />
        </ChartPanel>

        <ChartPanel title="Top Actors" eyebrow="Top-billed cast, top 20">
          <LabelCountBarChart
            client:idle
            data={stats.topActors}
            emptyLabel="No cast metadata synced yet."
            scrollable
          />
        </ChartPanel>
      </div>
    </div>
  ) : (
    <ProfileSelectionPanel profiles={profiles} />
  )}
</BaseLayout>
