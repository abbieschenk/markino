---
import ProfileSwitcher from "@/components/profiles/profile-switcher.astro";
import { listLocalProfiles } from "@/lib/local-profiles";

const profiles = await listLocalProfiles();
const links = [
  { href: "/movies", label: "Movies" },
  { href: "/charts", label: "Charts" },
  { href: "/settings", label: "Settings" },
];
---

<header class="sticky top-0 z-10 border-b border-[var(--border)] bg-[color:color-mix(in_srgb,var(--background)_92%,white)] backdrop-blur">
  <div class="flex min-h-14 items-center justify-between gap-1 sm:gap-4">
    <a
      href="/"
      class="shrink-0 select-none text-base font-bold uppercase sm:text-xl [font-family:Futura,'Futura_PT','Trebuchet_MS',sans-serif]"
    >
      MARKINO
    </a>
    <div class="flex min-w-0 items-center gap-1 sm:gap-3">
      <nav class="flex shrink-0 items-center text-[11px] text-[var(--muted-foreground)] sm:gap-1 sm:text-sm">
        {links.map((link) => (
          <a
            href={link.href}
            class="px-1 py-1 hover:text-[var(--foreground)] sm:px-2"
          >
            {link.label}
          </a>
        ))}
      </nav>
      <ProfileSwitcher
        currentUser={Astro.locals.user}
        profiles={profiles}
      />
    </div>
  </div>
</header>
