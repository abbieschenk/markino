---
import ProfileSwitcher from "@/components/profiles/profile-switcher.astro";
import { listLocalProfiles } from "@/lib/local-profiles";

const profiles = await listLocalProfiles();
const links = [
  { href: "/movies", label: "Movies" },
  { href: "/charts", label: "Charts" },
  { href: "/settings", label: "Settings" },
];
---

<header class="sticky top-0 z-10 border-b border-[var(--border)] bg-[color:color-mix(in_srgb,var(--background)_92%,white)] backdrop-blur">
  <div class="flex min-h-14 items-center justify-between gap-4">
    <a
      href="/"
      class="select-none text-xl font-bold uppercase [font-family:Futura,'Futura_PT','Trebuchet_MS',sans-serif]"
    >
      MARKINO
    </a>
    <div class="flex flex-wrap items-center gap-3">
      <nav class="flex flex-wrap items-center gap-1 text-sm text-[var(--muted-foreground)]">
        {links.map((link) => (
          <a
            href={link.href}
            class="px-2 py-1 hover:text-[var(--foreground)]"
          >
            {link.label}
          </a>
        ))}
      </nav>
      <ProfileSwitcher
        currentUser={Astro.locals.user}
        profiles={profiles}
      />
    </div>
  </div>
</header>
