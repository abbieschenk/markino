---
import ChartPanel from "@/components/charts/chart-panel.astro";
import GenreOverTimeChart from "@/components/charts/genre-over-time-chart.svelte";
import type { GenreOverTimeCount } from "@/lib/movie-chart-stats";

type Props = {
  yearlyData: GenreOverTimeCount[];
};

const { yearlyData } = Astro.props;
---

<ChartPanel title="Genres Over Time">
  <GenreOverTimeChart client:visible yearlyData={yearlyData} />
</ChartPanel>
